  @@index([linkedVpnUsername])
  @@index([waveNumber])
  @@index([deadlineAt])
  @@index([verifiedAt])
  @@index([enforcedAt])
  @@index([status, enforcementClaimedUntil])
  @@index([finalNoticeStatus, finalNoticeClaimedUntil])
