  accessRequestId           String?
  vpnAccountId              String?
  originalAdEnabled         Boolean?
  originalAdStatus          String?
  originalVpnStatus         String?
  originalVpnPortalType     String?
  originalSnapshot          Json?
  targetDirectoryObjectGuid String?
  expectedRequestVersion    Int?
  tokenHash                 String?                          @unique
  waveNumber                Int                              @default(0)
  status                    String                           @default("dry_run_ready")
  skipReason                String?
  projectedDeadlineAt       DateTime?
  projectedAction           String?
  emailClaimedAt            DateTime?
  initialEmailSentAt        DateTime?
  initialEmailMessageId     String?
  reminder3ClaimedAt        DateTime?
  reminder3SentAt           DateTime?
  reminder6ClaimedAt        DateTime?
  reminder6SentAt           DateTime?
  deadlineAt                DateTime?
  verifiedAt                DateTime?
  verifiedIpAddress         String?
  verifiedUserAgent         String?
  enforcementClaimedAt      DateTime?
  enforcementClaimId        String?                          @unique
  enforcementClaimedUntil   DateTime?
  enforcementFailureCounted Boolean                          @default(false)
  enforcementExpectedAd     Boolean?
  enforcementExpectedVpn    Boolean?
  enforcedAt                DateTime?
