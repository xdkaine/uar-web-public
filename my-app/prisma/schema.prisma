generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AccessRequest {
  id                              String                          @id @default(cuid())
  createdAt                       DateTime                        @default(now())
  updatedAt                       DateTime                        @updatedAt
  version                         Int                             @default(0)
  name                            String
  email                           String
  isInternal                      Boolean
  needsDomainAccount              Boolean
  institution                     String?
  eventReason                     String?
  eventId                         String?
  accessEndTime                   DateTime?
  isVerified                      Boolean                         @default(false)
  verificationToken               String?                         @unique
  verificationTokenHash           String?                         @unique
  verificationAttempts            Int                             @default(0)
  verifiedAt                      DateTime?
  verificationTokenExpiresAt      DateTime?
  status                          String                          @default("pending_verification")
  acknowledgedByDirector          Boolean                         @default(false)
  acknowledgedAt                  DateTime?
  acknowledgedBy                  String?
  approvedAt                      DateTime?
  approvedBy                      String?
  ldapUsername                    String?
  vpnUsername                     String?
  accountPassword                 String?
  accountCreatedAt                DateTime?
  provisioningState               String?
  provisioningStartedAt           DateTime?
  provisioningCompletedAt         DateTime?
  provisioningError               String?
  accountUpdateState              String? // in_progress | succeeded | failed | reconciliation_required
  accountUpdateClaimId            String?
  accountUpdateClaimedUntil       DateTime?
  accountUpdateTargetLdapUsername String?
  accountUpdateTargetVpnUsername  String?
  accountUpdateOutcome            Json?
  accountUpdateError              String?
  accountExpiresAt                DateTime?
  sentToFacultyAt                 DateTime?
  sentToFacultyBy                 String?
  facultyNotificationState        String? // sending | delivered | failed | delivery_unknown
  facultyNotificationClaimId      String?
  facultyNotificationClaimedUntil DateTime?
  facultyNotificationError        String?
  stageNotificationState          String? // delivery_unknown | delivered | failed
  stageNotificationStageKey       String?
  stageNotificationError          String?
  stageNotificationStateChangedAt DateTime?
  rejectedAt                      DateTime?
  rejectedBy                      String?
  rejectionReason                 String?
  approvalMessage                 String?
  isGrandfatheredAccount          Boolean                         @default(false) // For existing accounts without email
  isManuallyAssigned              Boolean                         @default(false) // Request linked to existing AD account
  manuallyAssignedAt              DateTime?
  manuallyAssignedBy              String?
  linkedAdUsername                String? // The existing AD username this request is linked to
  linkedVpnUsername               String? // The existing VPN username this request is linked to (for external users)
  manualAssignmentNotes           String? // Notes about the manual assignment
  // Account lifecycle tracking
  adAccountStatus                 String?                         @default("active") // "active", "disabled", "deleted"
  adDisabledAt                    DateTime?
  adDisabledBy                    String?
  adDisabledReason                String?
  adEnabledAt                     DateTime?
  adEnabledBy                     String?
  vpnAccountStatus                String?                         @default("active") // "active", "revoked", "deleted"
  vpnRevokedAt                    DateTime?
  vpnRevokedBy                    String?
  vpnRevokedReason                String?
  vpnRestoredAt                   DateTime?
  vpnRestoredBy                   String?
  requestTypeKey                  String?
  workflowVersionId               String?
  event                           Event?                          @relation(fields: [eventId], references: [id])
  comments                        RequestComment[]
  supportTickets                  SupportTicket[]
  activationToken                 AccountActivationToken?
  profileEmailVerificationTokens  ProfileEmailVerificationToken[]
  batchAccountItem                BatchAccountItem?
  // Removed global unique constraints - usernames can be reused after rejection or campaign offboarding
  // @@unique([ldapUsername])
  // @@unique([vpnUsername])
  // @@unique([linkedAdUsername])

  @@index([email])
  @@index([verificationToken])
  @@index([verificationTokenHash])
  @@index([status])
  @@index([eventId])
  @@index([ldapUsername])
  @@index([facultyNotificationState])
  @@index([facultyNotificationState, facultyNotificationClaimedUntil])
  @@index([stageNotificationState])
  @@index([provisioningState, provisioningStartedAt])
  @@index([accountUpdateState, accountUpdateClaimedUntil])
  @@index([vpnUsername])
  @@index([isManuallyAssigned])
  @@index([linkedAdUsername])
  @@index([linkedVpnUsername])
  @@index([adAccountStatus])
  @@index([vpnAccountStatus])
}

model RequestComment {
  id          String                     @id @default(cuid())
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  comment     String
  author      String
  requestId   String
  type        String?
  request     AccessRequest              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  attachments RequestCommentAttachment[]

  @@index([requestId])
  @@index([createdAt])
}

model RequestCommentAttachment {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  commentId     String
  comment       RequestComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  filename      String
  contentType   String
  sizeBytes     Int
  sha256        String
  storageKey    String         @unique
  uploadedBy    String
  scanStatus    String         @default("clean")
  forceDownload Boolean        @default(false)

  @@index([commentId])
  @@index([scanStatus])
}

model Event {
  id             String          @id @default(cuid())
  name           String
  description    String?
  endDate        DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accessRequests AccessRequest[]

  @@index([isActive])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
  @@index([expiresAt])
}

model AccountActivationToken {
  id              String        @id @default(cuid())
  accessRequestId String        @unique
  tokenHash       String        @unique
  expiresAt       DateTime
  used            Boolean       @default(false)
  usedAt          DateTime?
  attempts        Int           @default(0)
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now())
  accessRequest   AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([expiresAt])
  @@index([accessRequestId])
}

model PasswordChangeChallenge {
  id            String    @id @default(cuid())
  username      String
  tokenHash     String    @unique
  reason        String
  authProvider  String    @default("ad")
  correlationId String?
  expiresAt     DateTime
  state         String    @default("active") // active | processing | directory_applied | consumed
  claimedAt     DateTime?
  used          Boolean   @default(false)
  usedAt        DateTime?
  attempts      Int       @default(0)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([tokenHash])
  @@index([username])
  @@index([expiresAt])
}

model SupportTicket {
  id                     String                        @id @default(cuid())
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  subject                String
  category               String?
  severity               String?
  body                   String
  status                 String                        @default("open")
  username               String
  // Operational tickets emitted by trusted automation. These are visible and
  // mutable only through the administrator support workspace.
  internalOnly           Boolean                       @default(false)
  attachmentCount        Int                           @default(0)
  attachmentBytes        BigInt                        @default(0)
  closedAt               DateTime?
  closedBy               String?
  relatedRequestId       String?
  // Soft reference to AllowedTicketSubjectGroup.dn: the approved group this
  // ticket was filed on behalf of ("requested for"), when not self.
  requestedForGroupDn    String?
  // Soft reference to AllowedTicketSubjectGroup.dn: the group the requester
  // asks to join via this ticket. Only groups flagged canJoinViaTicket accept
  // values here; automation rules decide whether the add executes without a
  // human approver.
  joinGroupDn            String?
  relatedRequest         AccessRequest?                @relation(fields: [relatedRequestId], references: [id])
  responses              TicketResponse[]
  statusLogs             TicketStatusLog[]
  batchCreations         BatchAccountCreation[]
  assignments            SupportTicketAssignment[]
  assignmentHistory      TicketAssignmentHistory[]
  attachments            TicketAttachment[]
  quarantinedAttachments QuarantinedTicketAttachment[]

  @@index([username])
  @@index([internalOnly, status])
  @@index([status])
  @@index([createdAt])
  @@index([relatedRequestId])
  @@index([requestedForGroupDn])
  @@index([joinGroupDn])
}

model TicketResponse {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  message         String
  author          String
  isStaff         Boolean       @default(false)
  ticketId        String
  clientRequestId String?
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, clientRequestId])
  @@index([ticketId])
  @@index([createdAt])
}

// Profile email verification is intentionally separate from the public
// access-request verification token. Only a hash is stored; the claim lease
// prevents concurrent LDAP mutations and preserves forward-recovery evidence
// when the directory succeeds before the database can finalize.
model ProfileEmailVerificationToken {
  id                  String        @id @default(cuid())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  accessRequestId     String
  accessRequest       AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  tokenHash           String        @unique
  desiredEmail        String
  expiresAt           DateTime
  status              String        @default("issuing") // issuing | pending | claimed | directory_applied | completed | reconciliation_required | delivery_failed | revoked
  claimId             String?
  claimedUntil        DateTime?
  attempts            Int           @default(0)
  usedAt              DateTime?
  lastError           String?
  observedMail        String?
  observedDescription String?

  @@index([accessRequestId, status])
  @@index([expiresAt])
  @@index([claimedUntil])
}

model TicketAttachment {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename      String
  contentType   String
  sizeBytes     Int
  sha256        String
  storageKey    String        @unique
  uploadedBy    String
  scanStatus    String        @default("legacy_unscanned") // pending | clean | legacy_unscanned
  scannedAt     DateTime?
  forceDownload Boolean       @default(true)

  @@index([ticketId])
  @@index([scanStatus])
}

// Infected bytes never enter TicketAttachment. Keeping quarantine in a new
// table makes the objects unreachable to application versions predating the
// scan gate during a rollback.
model QuarantinedTicketAttachment {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  filename      String
  contentType   String
  sizeBytes     Int
  sha256        String
  storageKey    String        @unique
  uploadedBy    String
  scanSignature String?
  quarantinedAt DateTime      @default(now())
  purgedAt      DateTime?

  @@index([ticketId])
  @@index([quarantinedAt, purgedAt])
}

model TicketStatusLog {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  ticketId  String
  oldStatus String?
  newStatus String
  changedBy String
  isStaff   Boolean       @default(false)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

model BatchAccountCreation {
  id                     String             @id @default(cuid())
  submissionKey          String?            @unique
  submissionFingerprint  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  createdBy              String
  description            String
  totalAccounts          Int
  successfulAccounts     Int                @default(0)
  failedAccounts         Int                @default(0)
  status                 String             @default("processing")
  processingClaimId      String?
  processingClaimedUntil DateTime?
  completedAt            DateTime?
  linkedTicketId         String?
  linkedTicket           SupportTicket?     @relation(fields: [linkedTicketId], references: [id])
  accounts               BatchAccountItem[]
  auditLogs              BatchAuditLog[]

  @@index([createdBy])
  @@index([createdAt])
  @@index([status])
  @@index([status, processingClaimedUntil])
  @@index([linkedTicketId])
}

model BatchAccountItem {
  id                        String                   @id @default(cuid())
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  batchId                   String
  batch                     BatchAccountCreation     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accessRequestId           String?                  @unique
  accessRequest             AccessRequest?           @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)
  lifecycleOwnerKind        String                   @default("batch_item") // batch_item | access_request_legacy | unresolved
  lifecycleActions          AccountLifecycleAction[]
  vpnAccount                VPNAccount?
  version                   Int                      @default(0)
  accountType               String                   @default("AD") // "AD" or "VPN"
  name                      String
  email                     String?
  ldapUsername              String
  vpnUsername               String?
  password                  String
  accountExpiresAt          DateTime?
  isInternal                Boolean                  @default(true)
  status                    String                   @default("pending")
  mutationStage             String?
  ldapCreatedAt             DateTime?
  vpnCreatedAt              DateTime?
  errorMessage              String?
  completedAt               DateTime?
  targetDirectoryDn         String?
  targetDirectoryObjectGuid String?
  adAccountStatus           String? // active | disabled | deleted (AD items only; null means not reconciled)
  adDisabledAt              DateTime?
  adDisabledBy              String?
  adDisabledReason          String?
  adEnabledAt               DateTime?
  adEnabledBy               String?

  @@index([batchId])
  @@index([accessRequestId])
  @@index([status])
  @@index([ldapUsername])
  @@index([adAccountStatus])
}

model BatchAuditLog {
  id          String               @id @default(cuid())
  createdAt   DateTime             @default(now())
  batchId     String
  batch       BatchAccountCreation @relation(fields: [batchId], references: [id], onDelete: Cascade)
  action      String
  details     String
  performedBy String
  accountName String?
  success     Boolean

  @@index([batchId])
  @@index([createdAt])
  @@index([performedBy])
}

model VPNAccount {
  id                 String                @id @default(cuid())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  username           String                @unique
  name               String
  email              String?
  portalType         String // "Management", "Limited", "External"
  isInternal         Boolean               @default(false)
  status             String                @default("pending_faculty") // "active", "pending_faculty", "disabled", "revoked"
  expiresAt          DateTime?
  password           String
  createdBy          String
  createdByFaculty   Boolean               @default(false)
  facultyCreatedAt   DateTime?
  disabledAt         DateTime?
  disabledBy         String?
  disabledReason     String?
  revokedAt          DateTime? // When VPN access was revoked
  revokedBy          String? // Who revoked access
  revokedReason      String? // Why it was revoked
  restoredAt         DateTime? // When VPN access was restored
  restoredBy         String? // Who restored access
  canRestore         Boolean               @default(true) // Whether account can be restored after revocation
  notes              String?
  batchId            String?
  batchAccountItemId String?               @unique
  batchAccountItem   BatchAccountItem?     @relation(fields: [batchAccountItemId], references: [id], onDelete: SetNull)
  accessRequestId    String? // Link to the AccessRequest that created this VPN account
  importId           String? // Link to the VPNImport that imported this account
  adUsername         String? // Linked AD account username (for any account tied to an AD user)
  statusLogs         VPNAccountStatusLog[] @relation("LiveVPNAccountStatusLogs")
  comments           VPNAccountComment[]   @relation("LiveVPNAccountComments")

  @@index([username])
  @@index([portalType])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@index([accessRequestId])
  @@index([importId])
  @@index([revokedAt])
  @@index([adUsername])
}

model VPNAccountStatusLog {
  id                String                  @id @default(cuid())
  createdAt         DateTime                @default(now())
  accountId         String // Immutable historical VPN account ID
  liveAccountId     String? // Nullable live relation; cleared when the account record is deleted
  account           VPNAccount?             @relation("LiveVPNAccountStatusLogs", fields: [liveAccountId], references: [id], onDelete: SetNull)
  lifecycleActionId String? // Durable correlation for lifecycle-created status and activity evidence
  lifecycleAction   AccountLifecycleAction? @relation(fields: [lifecycleActionId], references: [id], onDelete: SetNull)
  oldStatus         String?
  newStatus         String
  changedBy         String
  reason            String?

  @@index([accountId])
  @@index([liveAccountId])
  @@index([lifecycleActionId])
  @@index([createdAt])
}

model VPNAccountComment {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  comment       String
  author        String
  accountId     String // Immutable historical VPN account ID
  liveAccountId String? // Nullable live relation; cleared when the account record is deleted
  type          String? // Optional: 'admin', 'system', 'note', etc.
  account       VPNAccount? @relation("LiveVPNAccountComments", fields: [liveAccountId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([liveAccountId])
  @@index([createdAt])
}

// VPN Import records - tracks spreadsheet imports of VPN users
model VPNImport {
  id               String            @id @default(cuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userType         String // "Internal" or "External" - which user type this import is for
  portalType       String? // "Management" or "Limited" - only for Internal users
  fileName         String // Original filename of the imported spreadsheet
  importedBy       String // Admin username who imported
  totalRecords     Int // Total records in import
  matchedRecords   Int               @default(0) // How many have been matched to AD accounts
  processedRecords Int               @default(0) // How many have been processed/created as VPN accounts
  createdAccounts  Int               @default(0) // How many VPN accounts have been created
  status           String            @default("pending") // "pending", "processing", "completed", "failed"
  notes            String?
  processedAt      DateTime? // When the queue item was fully processed
  expiresAt        DateTime? // Auto-cleanup timestamp
  importRecords    VPNImportRecord[]

  @@index([portalType])
  @@index([userType])
  @@index([importedBy])
  @@index([createdAt])
  @@index([status])
  @@index([processedAt])
  @@index([expiresAt])
}

// Individual records from VPN import spreadsheets
model VPNImportRecord {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  importId  String
  import    VPNImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  // Data from spreadsheet
  vpnUsername String // VPN username from spreadsheet
  fullName    String?
  email       String?
  notes       String?
  rawData     String? // JSON string of all imported fields

  // AD Matching
  matchStatus   String    @default("unmatched") // "unmatched", "matched", "no_match", "conflict"
  adUsername    String? // Matched Active Directory username
  adDisplayName String?
  adEmail       String?
  adDepartment  String?
  matchedBy     String? // Admin who performed the match
  matchedAt     DateTime?
  matchNotes    String?

  // VPN Account Creation
  vpnAccountCreated Boolean   @default(false)
  vpnAccountId      String?
  createdAt_vpn     DateTime?

  @@index([importId])
  @@index([vpnUsername])
  @@index([matchStatus])
  @@index([adUsername])
}

model Session {
  id                 String    @id @default(cuid())
  tokenHash          String    @unique
  username           String
  isAdmin            Boolean   @default(false)
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  lastActivity       DateTime  @default(now())
  revokedAt          DateTime?
  ipAddress          String?
  userAgent          String?
  authProvider       String    @default("ad") // "oidc" | "ad" | "ad_manual" | "ad_outage_fallback" | "local" | "local_manual"
  // OIDC provider session uid (ID token `sid`). Set only for sessions
  // established through the auth service; logout uses it to destroy the IdP
  // session so a subsequent login re-prompts for credentials.
  providerSid        String?
  // First-party portal binding. New fields stay nullable/disabled until the
  // device-risk rollout moves from shadow to enforcement.
  deviceBindingState String? // pending | verified | reauth_required
  deviceCookieHash   String?
  fingerprintVersion Int?
  fingerprintHash    String?
  deviceVerifiedAt   DateTime?
  riskLevel          String?

  @@index([username])
  @@index([expiresAt])
  @@index([riskLevel, createdAt])
}

model ProviderLogoutTask {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String
  providerSid     String
  providerSidHash String    @unique
  reason          String
  status          String    @default("pending") // pending | processing | completed | reconciliation_required
  claimId         String?   @unique
  claimedAt       DateTime?
  claimedUntil    DateTime?
  attempts        Int       @default(0)
  completedAt     DateTime?
  lastError       String?

  @@index([status, claimedUntil])
  @@index([username, createdAt])
}

// Local break-glass accounts (ADR-0009). Never seeded with credentials by any
// migration; created and rotated only by system administrators through System
// Configuration. Password material is stored solely as a salted scrypt hash.
model LocalAccount {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  username     String    @unique
  passwordHash String // scrypt$N$r$p$saltB64$keyB64 - never plaintext
  purpose      String    @default("break_glass")
  isActive     Boolean   @default(true)
  createdBy    String
  lastUsedAt   DateTime?
  lastUsedIp   String?

  @@index([isActive])
}

model BlockedEmail {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  email             String    @unique
  reason            String
  notes             String?
  linkedTicketId    String?
  blockedBy         String
  isActive          Boolean   @default(true)
  deactivatedAt     DateTime?
  deactivatedBy     String?
  deactivationNotes String?

  @@index([email])
  @@index([isActive])
  @@index([blockedBy])
  @@index([createdAt])
}

model SystemSettings {
  id                           String   @id @default(cuid())
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  loginDisabled                Boolean  @default(false)
  internalRegistrationDisabled Boolean  @default(false)
  externalRegistrationDisabled Boolean  @default(false)
  globalNotificationBanner     String? // Legacy field - use NotificationBanner model instead
  notificationBannerType       String? // Legacy field - use NotificationBanner model instead
  lastModifiedBy               String?
  manualOverride               Boolean  @default(false) // When true, only DB edit can re-enable logins
  authMode                     String? // Effective sign-in mode override: "oidc" | "native" | "local" (null = env AUTH_MODE)

  // Email Configuration
  emailFrom             String? // "From" email address
  adminEmail            String? // Admin notification email
  facultyEmail          String? // Faculty approval notification email
  studentDirectorEmails String? // Comma-separated list of student director emails

  @@index([loginDisabled])
  @@index([internalRegistrationDisabled])
  @@index([externalRegistrationDisabled])
}

model NotificationBanner {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  message     String
  type        String // "info", "warning", "error", "success"
  priority    Int       @default(0) // Higher numbers display first
  isActive    Boolean   @default(true)
  startDate   DateTime? // Optional: when to start showing
  endDate     DateTime? // Optional: when to stop showing
  createdBy   String
  dismissible Boolean   @default(true)

  @@index([isActive])
  @@index([priority])
  @@index([startDate])
  @@index([endDate])
}

model MassEmailCampaign {
  id                     String               @id @default(cuid())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  name                   String?
  subject                String
  html                   String
  text                   String
  createdBy              String
  status                 String               @default("draft") // "draft", "active", "completed", "cancelled"
  quickSend              Boolean              @default(false)
  dryRunAt               DateTime             @default(now())
  activatedAt            DateTime?
  activatedBy            String?
  activationClaimId      String?              @unique
  activationClaimedUntil DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancelledBy            String?
  targetSnapshot         Json?
  totalRecipients        Int                  @default(0)
  eligibleRecipients     Int                  @default(0)
  skippedRecipients      Int                  @default(0)
  sentCount              Int                  @default(0)
  failedCount            Int                  @default(0)
  recipients             MassEmailRecipient[]
  logs                   MassEmailLog[]

  @@index([status])
  @@index([createdAt])
  @@index([createdBy])
  @@index([status, activationClaimedUntil])
}

model MassEmailRecipient {
  id                     String            @id @default(cuid())
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  campaignId             String
  campaign               MassEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email                  String
  displayName            String?
  adUsername             String?
  adDn                   String?
  accountEnabled         Boolean?
  status                 String            @default("ready") // ready | pending_send | sending | sent | failed | delivery_unknown | retry_authorized
  sources                Json?
  emailClaimedAt         DateTime?
  emailClaimId           String?           @unique
  emailClaimedUntil      DateTime?
  deliveryAttempts       Int               @default(0)
  deliveryFailureCounted Boolean           @default(false)
  sentAt                 DateTime?
  messageId              String?
  failedAt               DateTime?
  lastError              String?
  logs                   MassEmailLog[]

  @@unique([campaignId, email])
  @@index([campaignId])
  @@index([status])
  @@index([status, emailClaimedUntil])
  @@index([email])
  @@index([adUsername])
}

model MassEmailLog {
  id          String              @id @default(cuid())
  createdAt   DateTime            @default(now())
  campaignId  String
  campaign    MassEmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   MassEmailRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  level       String              @default("info")
  eventType   String
  actor       String?
  message     String
  details     Json?

  @@index([campaignId])
  @@index([recipientId])
  @@index([eventType])
  @@index([level])
  @@index([createdAt])
}

model AuditLog {
  id                       String   @id @default(cuid())
  createdAt                DateTime @default(now())
  action                   String // Action type: "view_page", "create", "update", "delete", "approve", "reject", etc.
  category                 String // Category: "access_request", "event", "user", "batch", "vpn", "support", "settings", "blocklist", "navigation"
  username                 String // Admin who performed the action
  actorType                String? // "admin", "user", "system", or "anonymous"
  targetId                 String? // ID of the affected resource (if applicable)
  targetType               String? // Type of target: "AccessRequest", "Event", "User", "Batch", "VPNAccount", "SupportTicket", etc.
  subjectUsername          String? // User/account username this log entry is about
  subjectEmail             String? // User/account email this log entry is about
  relatedRequestId         String? // AccessRequest ID this action affected or was derived from
  relatedVpnAccountId      String? // VPNAccount ID this action affected or was derived from
  relatedLifecycleActionId String? // AccountLifecycleAction ID this action affected or was derived from
  eventKind                String? // "read", "write", "notification", "security", "system", "lifecycle", "sync"
  outcome                  String? // "success", "failure", "denied", "pending", "rollback", "skipped"
  correlationId            String? // Groups multi-step operations across logs
  clientId                 String? // OIDC relying party when the event is application-scoped
  providerSid              String? // IdP provider session identifier when applicable
  riskLevel                String? // low | medium | high for device/session evidence
  details                  String? // JSON string with additional details about the action
  ipAddress                String? // IP address of the admin
  userAgent                String? // Browser/user agent information
  success                  Boolean  @default(true) // Whether the action succeeded
  errorMessage             String? // Error message if action failed

  @@index([username])
  @@index([action])
  @@index([category])
  @@index([createdAt])
  @@index([targetType])
  @@index([success])
  @@index([actorType])
  @@index([subjectUsername, createdAt])
  @@index([subjectEmail, createdAt])
  @@index([relatedRequestId, createdAt])
  @@index([relatedVpnAccountId, createdAt])
  @@index([relatedLifecycleActionId, createdAt])
  @@index([eventKind])
  @@index([clientId, createdAt])
  @@index([riskLevel, createdAt])
  @@index([outcome, createdAt])
  @@index([outcome])
  @@index([correlationId])
}

// Account Lifecycle Management - Track disable/enable operations for AD and VPN accounts
model AccountLifecycleAction {
  id                        String                     @id @default(cuid())
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  actionType                String // "disable_ad", "enable_ad", "delete_ad", "revoke_vpn", "restore_vpn", "delete_vpn_record", "promote_vpn_role", "demote_vpn_role"
  targetAccountType         String // "AD", "VPN", "BOTH"
  targetUsername            String // The username (AD or VPN) being affected
  targetUserId              String? // Link to AccessRequest or VPNAccount ID
  operationMode             String                     @default("governed") // governed | batch_governed | directory_override
  targetDirectoryDn         String? // Immutable-at-confirmation directory target snapshot
  targetDirectoryObjectGuid String? // Immutable AD object identity captured at confirmation
  bindingFailureCode        String? // Why governed request linkage was unavailable
  preflightSnapshot         Json? // Directory/application state observed before execution
  resultSnapshot            Json? // Directory state read back after execution
  authorizationEvidence     Json? // Override acknowledgement and effective authorization evidence
  policyVersion             String? // Lifecycle policy contract used for confirmation
  status                    String                     @default("queued") // "queued", "processing", "completed", "failed", "reconciliation_required", "cancelled"
  reason                    String // Why the action is being taken
  requestedBy               String // Admin username who requested
  requestedAt               DateTime                   @default(now())
  scheduledFor              DateTime? // Optional: schedule for future execution
  processedAt               DateTime?
  processedBy               String? // System or admin who processed
  claimId                   String? // Identifies the worker currently allowed to finalize this action
  claimedUntil              DateTime? // Expired processing claims may be recovered by another worker
  attempts                  Int                        @default(0)
  completedAt               DateTime?
  errorMessage              String?
  rollbackData              String? // JSON string with data needed for rollback
  relatedRequestId          String? // Link to AccessRequest if applicable
  relatedBatchAccountItemId String? // BatchAccountItem ownership ledger when no AccessRequest exists
  relatedBatchAccountItem   BatchAccountItem?          @relation(fields: [relatedBatchAccountItemId], references: [id], onDelete: SetNull)
  relatedTicketId           String? // Link to SupportTicket if applicable
  targetGroupDn             String? // Durable group target for membership actions
  targetGroupObjectGuid     String? // Immutable AD group identity captured at confirmation
  idempotencyKey            String?                    @unique // Stable workflow action key
  vpnRoleChange             String? // For role changes: "Limited->Management", "Management->Limited"
  adDisabled                Boolean                    @default(false) // Track if AD portion completed
  vpnDisabled               Boolean                    @default(false) // Track if VPN portion completed
  canRestore                Boolean                    @default(true) // Whether this account can be restored
  notes                     String? // Additional notes
  batchId                   String? // Link to AccountLifecycleBatch if part of batch
  batch                     AccountLifecycleBatch?     @relation(fields: [batchId], references: [id])
  planTargetKey             String? // Stable per-account key inside a reviewed lifecycle plan
  planOrdinal               Int? // Server-enforced record order inside a reviewed deletion plan
  offboardCampaignId        String? // Link to an offboard campaign if this action was created by campaign enforcement/rollback
  offboardRecipientId       String? // Link to the offboard campaign recipient that caused this action
  offboardOperationRunId    String? // Exact reviewed activation/rollback run authorizing this action
  offboardCampaign          OffboardCampaign?          @relation(fields: [offboardCampaignId], references: [id], onDelete: SetNull)
  offboardRecipient         OffboardCampaignRecipient? @relation(fields: [offboardRecipientId], references: [id], onDelete: SetNull)
  offboardOperationRun      OffboardOperationRun?      @relation(fields: [offboardOperationRunId], references: [id], onDelete: SetNull)
  history                   AccountLifecycleHistory[]
  adActivityLogs            ADAccountActivityLog[]
  vpnActivityLogs           VPNAccountActivityLog[]
  vpnStatusLogs             VPNAccountStatusLog[]

  @@unique([batchId, planTargetKey, actionType])
  @@unique([batchId, planOrdinal])
  @@index([targetUsername])
  @@index([operationMode])
  @@index([status])
  @@index([actionType])
  @@index([requestedBy])
  @@index([createdAt])
  @@index([scheduledFor])
  @@index([status, claimedUntil])
  @@index([batchId])
  @@index([relatedRequestId])
  @@index([relatedBatchAccountItemId])
  @@index([relatedTicketId])
  @@index([targetGroupDn])
  @@index([targetUserId])
  @@index([offboardCampaignId])
  @@index([offboardRecipientId])
  @@index([offboardOperationRunId])
}

model OffboardCampaign {
  id                         String                      @id @default(cuid())
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  name                       String
  createdBy                  String
  workflowMode               String                      @default("verification") // "verification" | "direct"
  status                     String                      @default("dry_run") // "dry_run", "active", "completed", "cancelled"
  dryRunAt                   DateTime                    @default(now())
  activatedAt                DateTime?
  activatedBy                String?
  completedAt                DateTime?
  cancelledAt                DateTime?
  cancelledBy                String?
  emergencyStoppedAt         DateTime?
  emergencyStoppedBy         String?
  activeLockKey              String?                     @unique
  waveSize                   Int                         @default(25)
  canarySize                 Int                         @default(0)
  currentWave                Int                         @default(0)
  pauseAfterEachWave         Boolean                     @default(true)
  sendingPaused              Boolean                     @default(true)
  remindersPaused            Boolean                     @default(false)
  enforcementPaused          Boolean                     @default(false)
  executionPaused            Boolean                     @default(true) // Direct-mode claim gate; does not interrupt an in-flight recipient
  sendingCompletedAt         DateTime?
  directExecutionCompletedAt DateTime?
  activationOperationRunId   String?
  directOffboardReason       String?
  directOffboardReference    String?
  directAcknowledgedAt       DateTime?
  directAcknowledgedBy       String?
  rollbackState              String                      @default("none") // "none", "previewed", "processing", "completed", "failed"
  rollbackStartedAt          DateTime?
  rollbackStartedBy          String?
  rollbackCompletedAt        DateTime?
  manualExcludedUsernames    Json?
  manualExcludedEmails       Json?
  summaryJson                Json?
  totalRecipients            Int                         @default(0)
  eligibleRecipients         Int                         @default(0)
  skippedRecipients          Int                         @default(0)
  sentCount                  Int                         @default(0)
  reminder3Count             Int                         @default(0)
  reminder6Count             Int                         @default(0)
  verifiedCount              Int                         @default(0)
  enforcedCount              Int                         @default(0)
  failedCount                Int                         @default(0)
  finalNoticeSentCount       Int                         @default(0)
  finalNoticeFailureCount    Int                         @default(0)
  rollbackSuccessCount       Int                         @default(0)
  rollbackFailureCount       Int                         @default(0)
  recipients                 OffboardCampaignRecipient[]
  logs                       OffboardCampaignLog[]
  extensions                 OffboardCampaignExtension[]
  lifecycleActions           AccountLifecycleAction[]
  operationRuns              OffboardOperationRun[]
  vpnIdentityFences          VpnIdentityOffboardFence[]

  @@index([status])
  @@index([workflowMode, status])
  @@index([createdAt])
  @@index([activeLockKey])
}

// Immutable operator-approved snapshot for an activation or rollback. The
// snapshot is claimed before any external work begins so a browser retry cannot
// create a second AD/VPN mutation.
model OffboardOperationRun {
  id                    String                     @id @default(cuid())
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  campaignId            String
  campaign              OffboardCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor                 String
  kind                  String // "activation" | "rollback"
  digest                String
  expiresAt             DateTime
  status                String                     @default("previewed") // "previewed", "claimed", "completed", "failed", "stale", "expired", "reconciliation_required"
  claimId               String?                    @unique
  claimedAt             DateTime?
  claimedUntil          DateTime?
  idempotencyKey        String?                    @unique
  policyVersion         String?
  authorizationEvidence Json?
  summary               Json?
  items                 OffboardOperationRunItem[]
  lifecycleActions      AccountLifecycleAction[]

  @@index([campaignId, kind, createdAt])
  @@index([status, expiresAt])
}

model OffboardOperationRunItem {
  id            String                     @id @default(cuid())
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  runId         String
  run           OffboardOperationRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  recipientId   String?
  recipient     OffboardCampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  position      Int
  expectedState Json
  actions       Json
  conflicts     Json
  outcome       Json?
  status        String                     @default("previewed") // "previewed", "skipped", "completed", "failed", "reconciliation_required"

  @@unique([runId, position])
  @@index([recipientId])
  @@index([runId, status])
}

model OffboardCampaignRecipient {
  id                        String                           @id @default(cuid())
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  campaignId                String
  campaign                  OffboardCampaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email                     String
  displayName               String?
  adUsername                String
  adDn                      String?
