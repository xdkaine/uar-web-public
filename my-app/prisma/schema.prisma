  rollbackAdActionId        String?
  rollbackVpnActionId       String?
  rollbackError             String?
  lastError                 String?
  finalNoticeStatus         String                           @default("not_applicable") // not_applicable | pending | sending | sent | failed | reconciliation_required
  finalNoticeClaimId        String?                          @unique
  finalNoticeClaimedAt      DateTime?
  finalNoticeClaimedUntil   DateTime?
  finalNoticeSentAt         DateTime?
  finalNoticeMessageId      String?
  finalNoticeError          String?
