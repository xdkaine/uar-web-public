// Durable cross-path fence established when a reviewed direct-offboarding
// recipient is claimed. A database trigger consults this row before any VPN
// identity can become live, so imports, admin changes, and provisioning all
// share the same race boundary.
model VpnIdentityOffboardFence {
  canonicalAdUsername    String                    @id
  campaignId             String
  campaign               OffboardCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId            String                    @unique
  recipient              OffboardCampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  blockedAccessRequestId String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([campaignId])
  @@index([blockedAccessRequestId])
}

model OffboardCampaignRecipientToken {
  id          String                    @id @default(cuid())
  createdAt   DateTime                  @default(now())
  recipientId String
  recipient   OffboardCampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  tokenHash   String                    @unique
  purpose     String                    @default("initial")
  expiresAt   DateTime?
  usedAt      DateTime?

  @@index([recipientId])
  @@index([expiresAt])
  @@index([usedAt])
}

model OffboardCampaignLog {
  id          String                     @id @default(cuid())
  createdAt   DateTime                   @default(now())
  campaignId  String
  campaign    OffboardCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   OffboardCampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  level       String                     @default("info")
  eventType   String
  actor       String?
  message     String
  details     Json?

  @@index([campaignId])
  @@index([recipientId])
  @@index([eventType])
  @@index([level])
  @@index([createdAt])
}

model OffboardCampaignExtension {
  id                      String                              @id @default(cuid())
  createdAt               DateTime                            @default(now())
  updatedAt               DateTime                            @updatedAt
  campaignId              String
  campaign                OffboardCampaign                    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId             String
  recipient               OffboardCampaignRecipient           @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdBy               String
  note                    String?
  previousDeadlineAt      DateTime?
  newDeadlineAt           DateTime
  previousStatus          String
  status                  String                              @default("pending_notification")
  reactivationRequired    Boolean                             @default(false)
  reactivationAdActionId  String?
  reactivationVpnActionId String?
  notificationSentAt      DateTime?
  notificationMessageId   String?
  notificationError       String?
  reminders               OffboardCampaignExtensionReminder[]

  @@index([campaignId])
  @@index([recipientId])
  @@index([status])
  @@index([newDeadlineAt])
}

model OffboardCampaignExtensionReminder {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  extensionId  String
  extension    OffboardCampaignExtension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  claimedAt    DateTime?
  sentAt       DateTime?
  messageId    String?
  lastError    String?

  @@index([extensionId])
  @@index([scheduledFor])
  @@index([sentAt])
}

// Batch operations for account lifecycle (e.g., disable multiple accounts at once)
model AccountLifecycleBatch {
  id                    String                   @id @default(cuid())
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  batchType             String // "disable", "enable", "role_change"
  description           String
  requestedBy           String
  totalActions          Int
  completedActions      Int                      @default(0)
  failedActions         Int                      @default(0)
  status                String                   @default("pending") // "pending", "processing", "completed", "failed", "partial"
  startedAt             DateTime?
  completedAt           DateTime?
  relatedTicketId       String?
  notes                 String?
  idempotencyKey        String?                  @unique
  policyVersion         String?
  selectionDigest       String?
  authorizationEvidence Json?
  resultSummary         Json?
  totalTargets          Int                      @default(0)
  sourceBatchId         String?
  expiresAt             DateTime?
  confirmedAt           DateTime?
  confirmedBy           String?
  actions               AccountLifecycleAction[]

  @@index([requestedBy])
  @@index([status])
  @@index([createdAt])
  @@index([sourceBatchId])
  @@index([expiresAt])
}

// History tracking for all account lifecycle changes
model AccountLifecycleHistory {
  id             String                 @id @default(cuid())
  createdAt      DateTime               @default(now())
  actionId       String
  action         AccountLifecycleAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  event          String // "created", "queued", "processing", "completed", "failed", "cancelled", "rolled_back"
  details        String? // JSON string with additional details
  performedBy    String?
  previousStatus String?
  newStatus      String?

  @@index([actionId])
  @@index([createdAt])
}

// VPN Role Management - Track portal type changes (Limited <-> Management)
model VPNRoleChange {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  vpnAccountId    String
  username        String
  previousRole    String // "Limited", "Management", "External"
  newRole         String // "Limited", "Management", "External"
  changedBy       String
  reason          String
  relatedActionId String? // Link to AccountLifecycleAction if applicable
  notes           String?

  @@index([vpnAccountId])
  @@index([username])
  @@index([createdAt])
  @@index([relatedActionId])
}

// AD Account Sync - Automatic synchronization of existing AD accounts with VPN access
model ADAccountSync {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("running") // "running", "completed", "failed", "partial"
  triggeredBy String // Admin username who triggered the sync

  // Statistics
  totalADAccounts  Int @default(0) // Total AD accounts found with @cpp.edu
  totalVPNAccounts Int @default(0) // Total VPN accounts in Limited portal
  matchedAccounts  Int @default(0) // Successfully matched accounts
  unmatchedAD      Int @default(0) // AD accounts without VPN match
  unmatchedVPN     Int @default(0) // VPN accounts without AD match
  autoAssigned     Int @default(0) // Access requests automatically assigned

  errorMessage String? // Error if sync failed
  notes        String?
  matches      ADAccountMatch[]
  taggingTasks InfrastructureTaggingTask[]

  @@index([triggeredBy])
  @@index([createdAt])
  @@index([status])
}

model InfrastructureTaggingTask {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  syncId          String
  sync            ADAccountSync @relation(fields: [syncId], references: [id], onDelete: Cascade)
  adUsername      String
  accessRequestId String
  status          String        @default("pending") // pending | processing | completed | failed | reconciliation_required
  attempts        Int           @default(0)
  claimId         String?
  claimedUntil    DateTime?
  lastError       String?
  completedAt     DateTime?

  @@unique([syncId, adUsername])
  @@index([status, updatedAt])
  @@index([status, claimedUntil])
}

// Individual matches found during AD sync
model ADAccountMatch {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  syncId    String
  sync      ADAccountSync @relation(fields: [syncId], references: [id], onDelete: Cascade)

  // AD Account Info
  adUsername    String // e.g., "billy"
  adDisplayName String
  adEmail       String // e.g., "billy@cpp.edu"

  // VPN Account Info (if matched)
  vpnUsername  String? // e.g., "billy" (from Limited portal)
  vpnAccountId String? // Link to VPNAccount if it exists

  // Access Request Info (if found)
  accessRequestId String? // Link to AccessRequest if found
  requestEmail    String? // Email from the access request
  requestName     String? // Name from the access request

  // Match Status
  matchType       String // "full_match", "ad_only", "vpn_only", "no_request"
  wasAutoAssigned Boolean   @default(false) // Was this automatically assigned to a request?
  assignedAt      DateTime?

  notes String?

  @@index([syncId])
  @@index([adUsername])
  @@index([vpnUsername])
  @@index([accessRequestId])
  @@index([matchType])
}

// AD Account Activity Log - Track all enable/disable actions with lifecycle action references
model ADAccountActivityLog {
  id                String                  @id @default(cuid())
  createdAt         DateTime                @default(now())
  accountId         String // AccessRequest ID
  accountUsername   String // Username at time of action
  accountName       String? // Display name at time of action
  accountEmail      String? // Email at time of action
  actionType        String // "disabled", "enabled", "deleted"
  performedBy       String // Admin username
  reason            String? // Why the action was taken
  lifecycleActionId String? // Link to AccountLifecycleAction if applicable
  lifecycleAction   AccountLifecycleAction? @relation(fields: [lifecycleActionId], references: [id], onDelete: SetNull)
  notes             String? // Additional context
  ldapSuccess       Boolean                 @default(false) // Whether LDAP operation succeeded
  ldapError         String? // Any LDAP error message

  @@index([accountId])
  @@index([accountUsername])
  @@index([lifecycleActionId])
  @@index([createdAt])
  @@index([performedBy])
}

// VPN Account Activity Log - Track all enable/disable/role changes with lifecycle action references
model VPNAccountActivityLog {
  id                String                  @id @default(cuid())
  createdAt         DateTime                @default(now())
  accountId         String // VPNAccount ID
  accountUsername   String // Username at time of action
  accountName       String // Display name at time of action
  accountEmail      String? // Email at time of action
  actionType        String // "disabled", "enabled", "revoked", "restored", "deleted", "role_promoted", "role_demoted"
  performedBy       String // Admin username
  reason            String? // Why the action was taken
  lifecycleActionId String? // Link to AccountLifecycleAction if applicable
  lifecycleAction   AccountLifecycleAction? @relation(fields: [lifecycleActionId], references: [id], onDelete: SetNull)
  oldPortalType     String? // For role changes
  newPortalType     String? // For role changes
  notes             String? // Additional context

  @@index([accountId])
  @@index([accountUsername])
  @@index([lifecycleActionId])
  @@index([createdAt])
  @@index([performedBy])
}

// AD Account Comments - Comments tied to account ID, not username (to avoid inheritance)
model ADAccountComment {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accountId       String // AccessRequest ID - permanent identifier
  accountUsername String // Username at time of comment (for reference)
  comment         String
  author          String // Admin username
  isInternal      Boolean   @default(false) // Internal admin note vs visible to others
  isPinned        Boolean   @default(false) // Pin important comments
  editedAt        DateTime?
  deletedAt       DateTime? // Soft delete
  deletedBy       String?

  @@index([accountId])
  @@index([author])
  @@index([createdAt])
  @@index([isPinned])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Modular configuration, governance workflow, messaging, and RBAC models.
// Additive only: existing tables and data are untouched. All new capability
// state defaults to "enabled"/"current behavior" so the first deployment is
// behavior-preserving (see docs/architecture/modularity-configuration-roadmap.md).
// ---------------------------------------------------------------------------

// Runtime enabled/disabled state for optional capabilities. Modules known to
// the application are defined in code (my-app/lib/modules/registry.ts); this
// table only stores operator overrides. A missing row means the module is
// enabled, which preserves current behavior on first deployment.
model ModuleState {
  id        String   @id @default(cuid())
  moduleId  String   @unique
  enabled   Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

// Generic persisted configuration storage for typed keys registered in
// my-app/lib/config/registry.ts. Values are validated by the registry before
// being written. Secrets never belong here; they stay in environment or a
// dedicated secret store and are only referenced by name.
model SystemConfigEntry {
  key       String   @id
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Immutable before/after trail for persisted configuration changes. One row
// per changed key per write, appended when System Configuration saves or
// clears an override. Secret values are NEVER recorded - secret revisions
// store only a redaction marker so history proves a credential changed
// without exposing material (roadmap §6.14).
model ConfigurationRevision {
  id            String   @id @default(cuid())
  key           String
  previousValue Json?
  newValue      Json?
  changeKind    String   @default("update") // "update" | "clear" | "secret_change"
  changedBy     String
  reason        String?
  createdAt     DateTime @default(now())

  @@index([key])
  @@index([createdAt])
}

// One recorded execution of an authenticated cron route. Written best-effort:
// an observability failure must never fail the underlying job. Outcome values
// distinguish completed work from module-disabled skips so operators can see
// WHY nothing happened, matching the module skip-recording contract.
model CronRun {
  id             String    @id @default(cuid())
  route          String
  outcome        String    @default("success") // "success" | "failed" | "skipped_module_disabled"
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  itemsProcessed Int       @default(0)
  errorClass     String?
  detail         Json?

  @@index([route, startedAt])
  @@index([startedAt])
}

// Current projection of one curated operational problem. The detector and
// subject keys identify a single episode; repeated observations update this
// projection while immutable transitions are appended below.
model OperationalSignal {
  id              String                   @id @default(cuid())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  detectorKey     String
  subjectKey      String
  subjectType     String
  subjectId       String
  reasonCode      String
  fingerprint     String
  status          String                   @default("active") // active | resolved
  severity        String                   @default("warning") // info | warning | critical
  summary         String
  firstSeenAt     DateTime                 @default(now())
  lastSeenAt      DateTime                 @default(now())
  resolvedAt      DateTime?
  occurrenceCount Int                      @default(1)
  events          OperationalSignalEvent[]

  @@unique([detectorKey, subjectKey])
  @@index([status, lastSeenAt])
  @@index([subjectType, subjectId])
}

// Append-only, sanitized evidence for detector transitions. Raw logs, stack
// traces, request bodies, names, email addresses, credentials, and tokens are
// deliberately excluded from this model and its evidence JSON.
model OperationalSignalEvent {
  id                String                      @id @default(cuid())
  createdAt         DateTime                    @default(now())
  signalId          String
  signal            OperationalSignal           @relation(fields: [signalId], references: [id], onDelete: Restrict)
  eventKey          String                      @unique
  transition        String // detected | resolved
  detectorKey       String
  detectorVersion   Int                         @default(1)
  evidenceVersion   Int                         @default(1)
  sourceType        String
  sourceId          String?
  correlationId     String
  summary           String
  evidence          Json
  archiveEligibleAt DateTime
  archivedAt        DateTime?
  archiveId         String?
  archive           OperationalEvidenceArchive? @relation(fields: [archiveId], references: [id], onDelete: Restrict)

  @@index([signalId, createdAt])
  @@index([archiveEligibleAt, archivedAt])
  @@index([archiveId])
  @@index([correlationId])
}

// Manifest for a verified encrypted evidence bundle. The local application
// records archive intent and verification here; write-once/WORM enforcement
// remains a deployment storage policy and is never inferred from this row.
model OperationalEvidenceArchive {
  id                 String                   @id @default(cuid())
  createdAt          DateTime                 @default(now())
  rangeStart         DateTime
  rangeEnd           DateTime
  recordCount        Int
  storageKey         String                   @unique
  ciphertextSha256   String
  keyId              String
  formatVersion      Int                      @default(1)
  readbackVerifiedAt DateTime?
  retentionExpiresAt DateTime
  events             OperationalSignalEvent[]

  @@index([rangeEnd])
  @@index([retentionExpiresAt])
}

// Configurable access request governance. A RequestType names what is being
// requested; each published WorkflowDefinition version pins the ordered review
// stages that were in effect when requests referencing it were submitted.
model RequestType {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  description String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  workflows   WorkflowDefinition[]

  @@index([isActive])
}

// Immutable once created: editing governance publishes a new version row.
// Existing requests keep pointing at the version they were submitted under so
// in-flight governance can never change retroactively.
model WorkflowDefinition {
  id             String      @id @default(cuid())
  requestTypeKey String
  requestType    RequestType @relation(fields: [requestTypeKey], references: [key])
  version        Int
  status         String      @default("published") // "published" | "archived"
  stages         Json // Ordered WorkflowStageConfig[]; shape validated in lib/workflow/schema.ts
  createdBy      String?
  createdAt      DateTime    @default(now())

  @@unique([requestTypeKey, version])
  @@index([requestTypeKey, status])
}

// Organization-owned operational copy (e.g. the faculty handoff message).
// Keys are registered in lib/messages/catalog.ts with the exact current
// hard-coded content as the seeded value so output is unchanged on upgrade.
model MessageTemplate {
  id        String                    @id @default(cuid())
  key       String                    @unique
  label     String
  body      String
  subject   String? // Editable email subject line; null uses the code default
  variables Json? // Documented placeholder schema for editors
  updatedBy String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  revisions MessageTemplateRevision[]

  @@index([updatedAt])
}

model MessageTemplateRevision {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  templateKey String
  template    MessageTemplate @relation(fields: [templateKey], references: [key], onDelete: Cascade)
  version     Int
  status      String          @default("draft") // draft | published | archived
  subject     String?
  body        String
  css         String?
  createdBy   String
  updatedBy   String
  publishedAt DateTime?
  publishedBy String?

  @@unique([templateKey, version])
  @@index([templateKey, status])
}

// Application roles used by configurable review stages and admin surfaces.
// Permission catalogs are code-defined (my-app/lib/rbac/permissions.ts);
// adGroupDns maps directory groups to roles via live LDAP membership checks.
// The system_administrator role additionally inherits from the legacy
// LDAP_ADMIN_GROUPS domain-admin check for compatibility (ADR-0004).
//
// LEGACY (privilege-first RBAC): RoleDefinition is retained read-only for
// rollback. Authorization now resolves through PrivilegeAssignment below;
// this table's rows were migrated into it and are no longer consulted.
model RoleDefinition {
  key         String   @id
  name        String
  description String?
  permissions String[]
  adGroupDns  String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isSystem])
}

// ---------------------------------------------------------------------------
// Privilege-first RBAC: each code-registered privilege maps directly to AD
// group DNs. Membership is resolved live against the directory with the same
// canonical DN comparison the legacy admin gate uses; legacy domain admins
// (ldap.adminGroups) and break-glass accounts always hold the full catalog.
// A missing row simply means "no groups mapped to this privilege yet".
// ---------------------------------------------------------------------------
model PrivilegeAssignment {
  permissionKey String   @id
  adGroupDns    String[]
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([updatedAt])
}

// ---------------------------------------------------------------------------
// Support ticket ownership and directory-group routing (ADR-0007).
// Additive only. With no allowed groups, no snapshots, and no assignments the
// portal behaves exactly as before: unassigned tickets notify the default
// queue (adminEmail) and creators additionally receive a receipt.
// ---------------------------------------------------------------------------

// Administrator-approved AD groups usable in support-ticket flows. Only rows
// in this table may be used as "requested for" subjects or assignment owners;
// knowing a DN grants nothing.
model AllowedTicketSubjectGroup {
  id                String                         @id @default(cuid())
  dn                String                         @unique
  name              String
  mail              String? // Mail-enabled group address; preferred over member expansion when present
  canBeRequestedFor Boolean                        @default(true)
  canBeAssignee     Boolean                        @default(false)
  canJoinViaTicket  Boolean                        @default(false)
  // When true, a published workflow may add requesters without manual review
  // ("configured to be added automatically"). enqueue_group_add refuses
  // groups without this flag, so automation can never outrun policy.
  autoApproveJoin   Boolean                        @default(false)
  isActive          Boolean                        @default(true)
  lastSyncedAt      DateTime?
  lastSyncStatus    String? // "success" | "partial_failure" | "failed"
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  memberSnapshots   DirectoryGroupMemberSnapshot[]

  @@index([isActive])
}

// One recorded attempt to refresh membership snapshots for all active groups.
// Per-group outcomes live in errors; failed groups keep their previous snapshot.
model DirectorySyncRun {
  id              String    @id @default(cuid())
  status          String    @default("running") // running | success | partial_failure | failed
  triggeredBy     String // "cron" or acting username
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  groupsProcessed Int       @default(0)
  membersCaptured Int       @default(0)
  errors          Json?

  @@index([status])
  @@index([startedAt])
}

// Cached membership of one allowed group as captured by a sync run. AD/LDAP
// remains authoritative; this is the local read model that keeps form
// rendering and recipient expansion off the domain controller.
model DirectoryGroupMemberSnapshot {
  id             String                    @id @default(cuid())
  groupDn        String
  group          AllowedTicketSubjectGroup @relation(fields: [groupDn], references: [dn], onDelete: Restrict)
  syncRunId      String
  username       String
  email          String?
  displayName    String?
  accountEnabled Boolean?
  capturedAt     DateTime                  @default(now())

  @@unique([groupDn, username])
  @@index([username])
  @@index([syncRunId])
}

// Assignment is data with history, not merely an email destination. One row
// per target per ticket; deactivation preserves the row. targetGroupDn is an
// intentional soft reference (no FK) so removing a group from the allowlist
// never rewrites ticket history.
model SupportTicketAssignment {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ticketId       String
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  targetType     String // "user" | "directory_group"
  targetUsername String?
  targetGroupDn  String?
  targetLabel    String
  targetEmail    String? // Verified directory email captured when direct user access is granted
  isActive       Boolean       @default(false)
  assignedBy     String
  assignedAt     DateTime      @default(now())

  // Uniqueness of the ACTIVE assignment per target is enforced by partial
  // unique indexes in migration 20260822130000 (Prisma cannot express
  // partial indexes): one active user row and one active group row per
  // ticket, so concurrent assigns cannot create duplicate ownership.
  @@index([ticketId])
  @@index([targetUsername])
  @@index([targetGroupDn])
  @@index([isActive])
}

// Immutable audit trail of ownership changes on a ticket.
model TicketAssignmentHistory {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  action        String // "assign" | "unassign"
  targetType    String
  targetLabel   String
  actorUsername String
  details       Json?

  @@index([ticketId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Workflow automation, service alerts, and ticket evidence (ADR-0008/0010).
// Additive only. No rules are seeded enabled; with zero rules the portal
// behaves exactly as before.
// ---------------------------------------------------------------------------

// Operator-composed automation rule joining a code-defined trigger to ordered
// code-defined actions through validated conditions. Shapes are validated on
// write AND evaluation against lib/automation/catalog.ts; unknown keys
// disable the rule loudly instead of misfiring (ADR-0008).
model AutomationRule {
  id            String          @id @default(cuid())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  name          String
  description   String?
  triggerKey    String
  triggerConfig Json?
  conditions    Json? // Ordered condition configs; all must match
  actions       Json // Ordered action configs, each { key, config }
  enabled       Boolean         @default(false)
  createdBy     String?
  updatedBy     String?
  runs          AutomationRun[]

  @@index([triggerKey, enabled])
}

// One evaluation of one rule for one event. Unique (ruleId, eventKey) makes
// redelivery idempotent at the database layer (ADR-0008). Rules with runs can
// only be disabled, never deleted, so history stays reconstructable.
model AutomationRun {
  id         String         @id @default(cuid())
  createdAt  DateTime       @default(now())
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  eventKey   String
  triggerKey String
  status     String         @default("succeeded") // succeeded | failed | skipped
  matched    Boolean        @default(false)
  outcomes   Json? // Per-action results in execution order
  error      String?
  startedAt  DateTime       @default(now())
  finishedAt DateTime?

  @@unique([ruleId, eventKey])
  @@index([triggerKey])
  @@index([startedAt])
}

// Machine-raised operational alert (for example an unreachable domain
// controller) categorized and dismissible by administrators. Re-occurrence of
// the same condition increments counters on the dedupe key instead of
// duplicating rows; dismissal only sticks while the underlying condition is
// cleared - the next failing probe reopens it as a fresh occurrence.
model ServiceAlert {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  dedupeKey       String    @unique
  category        String // "directory" | "email" | "storage" | "general"
  severity        String    @default("warning") // info | warning | critical
  title           String
  message         String
  source          String // Emitting probe or integration, e.g. "dc_probe"
  status          String    @default("active") // active | resolved | dismissed
  occurrenceCount Int       @default(1)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  resolvedAt      DateTime?
  dismissedBy     String?
  dismissedAt     DateTime?
  metadata        Json?

  @@index([status])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Visual workflow graphs over curated nodes (ADR-0013). Supersedes the flat
// AutomationRule shape, which stays readable for history. No graphs are
// seeded enabled; with zero graphs the portal behaves exactly as before.
// ---------------------------------------------------------------------------

// One operator-designed graph. drafts hold nodes/edges JSONB; publishing
// stamps a version and enabling is an audited act (rules import as graphs).
model WorkflowGraph {
  id            String                 @id @default(cuid())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  name          String
  description   String?
  triggerKey    String // Which event family starts this graph
  nodes         Json // [{ id, type, config, position }]
  edges         Json // [{ id, source, sourceHandle?, target, condition? }]
  status        String                 @default("draft") // draft | published | disabled
  version       Int                    @default(1)
  enabled       Boolean                @default(false)
  createdBy     String?
  updatedBy     String?
  runs          FlowRun[]
  monitorChecks WorkflowMonitorCheck[]

  @@unique([name, version])
  @@index([triggerKey, enabled])
}

// One execution of one graph for one event; unique (graphId, eventKey) makes
// redelivery idempotent at the database layer (inherited from ADR-0008).
model FlowRun {
  id             String              @id @default(cuid())
  createdAt      DateTime            @default(now())
  graphId        String
  graph          WorkflowGraph       @relation(fields: [graphId], references: [id], onDelete: Restrict)
  eventKey       String
  triggerKey     String
  sourceNodeId   String?
  sourceHandle   String?
  contextDigest  String?
  context        Json?
  status         String              @default("running") // running | succeeded | failed | waiting | cancelled
  nodeOutcomes   Json? // Per-node { nodeId, status, startedAt, finishedAt, error }
  artifacts      FlowArtifact[]
  timers         FlowTimer[]
  actionAttempts FlowActionAttempt[]
  error          String?
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?

  @@unique([graphId, eventKey])
  @@index([triggerKey])
  @@index([status])
  @@index([startedAt])
}

model FlowActionAttempt {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  runId        String
  run          FlowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId       String
  kind         String
  status       String    @default("sending") // sending | processing | delivered | failed | delivery_unknown | reconciliation_required | retry_authorized
  claimId      String?   @unique
  claimedAt    DateTime?
  claimedUntil DateTime?
  attempts     Int       @default(0)
  messageId    String?
  lastError    String?
  outcome      Json?

  @@unique([runId, nodeId])
  @@index([status, claimedUntil])
}

// Persisted delay: a run parked until dueAt, drained by the workflow tick.
model FlowTimer {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  runId        String
  run          FlowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId       String
  dueAt        DateTime
  payload      Json? // Context snapshot carried across the wait
  status       String    @default("pending") // pending | processing | reconciliation_required
  claimId      String?   @unique
  claimedAt    DateTime?
  claimedUntil DateTime?
  attempts     Int       @default(0)
  lastError    String?

  @@index([status, dueAt])
  @@index([status, claimedUntil])
}

// Everything a run created so cleanup can cascade (clearing a service alert
// also clears banners that run raised, per ADR-0013).
model FlowArtifact {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  runId     String
  run       FlowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId    String
  kind      String // service_alert | notification_banner | ticket_response | lifecycle_action
  refId     String // The created object's id or dedupe key
  clearedAt DateTime?

  @@index([runId])
  @@index([refId])
}

// Durable bridge from security/operational producers into the workflow
// engine. A producer commits the event with its domain record; the workflow
// tick retries delivery until the graph-level idempotency key is accepted.
model FlowEventOutbox {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  triggerKey    String
  eventKey      String    @unique
  context       Json
  graphId       String?
  sourceNodeId  String?
  sourceHandle  String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  processedAt   DateTime?
  lastError     String?
  lockToken     String?
  lockedUntil   DateTime?

  @@index([processedAt, nextAttemptAt, lockedUntil])
}

model MonitoredEndpoint {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  configVersion        Int       @default(0)
  name                 String
  preset               String    @default("generic_https") // proxmox | truenas | generic_https | tcp
  protocol             String // https | tcp
  host                 String
  port                 Int
  path                 String?
  timeoutMs            Int       @default(5000)
  failureThreshold     Int       @default(2)
  recoveryThreshold    Int       @default(2)
  enabled              Boolean   @default(true)
  currentState         String    @default("unknown") // unknown | up | down
  consecutiveFailures  Int       @default(0)
  consecutiveSuccesses Int       @default(0)
  lastCheckedAt        DateTime?
  lastTransitionAt     DateTime?
  lastLatencyMs        Int?
  lastError            String?
  createdBy            String
  updatedBy            String

  @@index([enabled])
  @@index([currentState])
}

model WorkflowMonitorCheck {
  id                   String        @id @default(cuid())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  graphId              String
  graph                WorkflowGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)
  sourceNodeId         String
  checkKey             String
  configHash           String
  config               Json
  active               Boolean       @default(false)
  nextProbeAt          DateTime      @default(now())
  currentState         String        @default("unknown")
  consecutiveFailures  Int           @default(0)
  consecutiveSuccesses Int           @default(0)
  lastCheckedAt        DateTime?
  lastTransitionAt     DateTime?
  lastLatencyMs        Int?
  lastStatusCode       Int?
  lastError            String?

  @@unique([graphId, sourceNodeId, checkKey])
  @@index([active, nextProbeAt])
  @@index([graphId, active])
}

model MonitorCredential {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  configVersion Int      @default(0)
  name          String
  kind          String
  username      String?
  headerName    String?
  secret        String
  allowedHosts  String[]
  enabled       Boolean  @default(true)
  createdBy     String
  updatedBy     String

  @@index([enabled])
  @@index([kind])
}

model ManagedPageRevision {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pageKey     String
  version     Int
  status      String    @default("draft")
  document    Json
  createdBy   String
  updatedBy   String
  publishedAt DateTime?
  publishedBy String?

  @@unique([pageKey, version])
  @@index([pageKey, status])
}

model OperationalLease {
  key       String   @id
  owner     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model UserNotification {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  username    String
  dedupeKey   String
  kind        String
  severity    String    @default("info")
  title       String
  message     String
  href        String?
  readAt      DateTime?
  dismissedAt DateTime?

  @@unique([username, dedupeKey])
  @@index([username, dismissedAt, createdAt])
  @@index([username, readAt])
}

model UserNotificationPreference {
  username       String   @id
  accessRequests Boolean  @default(true)
  supportTickets Boolean  @default(true)
  syncFailures   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

// Sign-in branding and OIDC application registries intentionally have no
// portal models: the auth service is a self-contained product that owns its
// own branding console and client store. The portal only consumes it as a
// relying party via env-driven configuration (AUTH_MODE/AUTH_ISSUER/...).
