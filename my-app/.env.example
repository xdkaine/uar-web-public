# =============================================================================
# UAR Portal - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# ALL variables below are REQUIRED for the application to start
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Portal-runtime PostgreSQL connection string (TLS enforced). In a separated
# deployment this must use uar_portal_runtime. Never run the portal with the
# migration role; Compose supplies this value from PORTAL_DATABASE_URL.
# Format: postgresql://username:password@host:port/database?schema=public&sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/uar_web?schema=public&sslmode=require"
# Set true only for a trusted private container network whose Postgres has no TLS.
DATABASE_SSL_ALLOW_INSECURE=false

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
# SMTP server hostname (e.g., smtp.gmail.com, smtp.office365.com) - REQUIRED
SMTP_HOST="smtp.gmail.com"

# SMTP server port (587 for STARTTLS, 465 for SMTPS) - REQUIRED
SMTP_PORT="587"

# SMTP authentication username (usually your email address) - REQUIRED
SMTP_USER="your-email@cpp.edu"

# SMTP authentication password (use app-specific password for Gmail/Office365) - REQUIRED
SMTP_PASSWORD="your-app-password"

# -----------------------------------------------------------------------------
# Email Addresses (OPTIONAL - can be configured in Admin → Settings instead)
# These values are used as fallback if not configured in the database
# -----------------------------------------------------------------------------

# Email address to use in the "From" field (OPTIONAL - see Admin Settings)
EMAIL_FROM="noreply@calpolysoc.org"

# Admin email address for receiving new access request notifications (OPTIONAL - see Admin Settings)
ADMIN_EMAIL="soc@cpp.edu"

# Faculty email for VPN account approval notifications (OPTIONAL - see Admin Settings)
FACULTY_EMAIL="soc@cpp.edu"

# Student director emails - comma-separated list (OPTIONAL - see Admin Settings)
STUDENT_DIRECTOR_EMAILS="director1@cpp.edu,director2@cpp.edu"

# =============================================================================
# LDAP/ACTIVE DIRECTORY CONFIGURATION
# =============================================================================
# LDAP server URL - LDAPS required (StartTLS not currently supported by this build)
# Example: ldaps://kamino.cpp.edu:636
LDAP_URL="ldaps://kamino.cpp.edu:636"
# Optional: base64-encoded PEM CA certificate for a private LDAP certificate authority.
# Leave empty to use the operating system trust store.
LDAP_CA_CERT_BASE64=""

# Distinguished Name (DN) for LDAP bind authentication
# This account needs permission to read/create/modify user accounts
# Example: cn=admin,dc=cpp,dc=edu
LDAP_BIND_DN="cn=admin,dc=cpp,dc=edu"

# Password for the LDAP bind DN account
# CRITICAL: Keep this secure! This account has elevated privileges
LDAP_BIND_PASSWORD="your-ldap-password"

# Base DN for LDAP searches (where users are located in the directory)
# Example: ou=users,dc=cpp,dc=edu or dc=cpp,dc=edu
LDAP_SEARCH_BASE="ou=users,dc=cpp,dc=edu"

# Domain name for user principal names (UPN)
# This is appended to usernames: username@LDAP_DOMAIN
# Example: sdc.cpp or tommy.dev
LDAP_DOMAIN="sdc.cpp"

# JSON array of complete LDAP group DNs that grant UAR administrator access
# Users in these exact groups will have admin access to the UAR Portal
LDAP_ADMIN_GROUPS='["CN=Domain Admins,CN=Users,DC=example,DC=org"]'

# LDAP group DN to add newly created users to
# All new accounts will be added to this group automatically
# Example: CN=SDC Users,OU=Groups,DC=cpp,DC=edu
LDAP_GROUP2ADD="CN=SDC Users,OU=Groups,DC=cpp,DC=edu"
LDAP_KAMINO_INTERNAL_GROUP="CN=Internal Users,OU=Groups,DC=cpp,DC=edu"
LDAP_KAMINO_EXTERNAL_GROUP="CN=External Users,OU=Groups,DC=cpp,DC=edu"
# Set true ONLY for isolated lab environments whose directory certificates are expired or untrusted; traffic stays LDAPS-encrypted but is not verified.
LDAP_ALLOW_INVALID_CERTS=false

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Public URL where the application is hosted
# Used for generating links in emails and redirects
# Development: http://localhost:3000
# Production: https://uar.cpp.edu
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret key for NextAuth.js session encryption
# CRITICAL: Generate a secure random string (min 32 characters)
# Run: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secure-random-string-here-min-32-chars"

# Secret key for CSRF token generation and validation
# CRITICAL: Generate a secure random string (min 32 characters)
# Run: openssl rand -hex 32
CSRF_SECRET="generate-a-secure-random-hex-string-here-min-64-chars"

# =============================================================================
# CLOUDFLARE TURNSTILE CONFIGURATION
# =============================================================================
# Site Key (Public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Secret Key (Private)
TURNSTILE_SECRET_KEY="1x00000000000000000000BB"

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Secret key for encrypting sensitive data (passwords) at rest in the database
# CRITICAL: Generate a secure 64-character hex string (min 32 characters)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Do NOT change this after deploying - will break existing encrypted passwords
# WARNING: Do NOT commit this to git - keep in environment variables or secrets manager
ENCRYPTION_SECRET="generate-a-secure-64-char-hex-string-DO-NOT-SHARE"

# Salt for key derivation (used with ENCRYPTION_SECRET)
# CRITICAL: Generate a secure 32-character hex string (min 16 characters)
# Run: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# WARNING: Do NOT change this after deploying - will break existing encrypted passwords
# WARNING: Do NOT commit this to git - keep in environment variables or secrets manager
ENCRYPTION_SALT="generate-a-secure-32-char-hex-string-DO-NOT-SHARE"

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# Node environment (development, production, test)
# NODE_ENV="development"

# Session token lifetime override (seconds, defaults to 28800 / 8 hours)
# AUTH_SESSION_MAX_AGE="28800"
# OIDC/SSO portal cap; the signed upstream provider-session expiry may be earlier.
# Direct AD and local break-glass keep the shorter portal defaults above.
AUTH_OIDC_SESSION_MAX_AGE="28800"

# Legacy sign-in inputs. They are read only until auth.signInPolicy is saved in
# Admin -> System Configuration -> Sign-in. The saved portal policy is then
# authoritative.
AUTH_MODE=native
AUTH_ISSUER=http://localhost:4003
AUTH_CLIENT_ID=uar-portal
AUTH_CLIENT_SECRET=replace_with_a_random_oidc_client_secret_at_least_32_characters
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
OIDC_INTERNAL_ISSUER_URL=http://auth-service:3003
# Default copy used when migrating from legacy inputs. Operators can edit and
# save this as plain text in the portal Sign-in configuration.
AUTH_OIDC_DISPLAY_NAME="UAR Auth Service"
AUTH_OIDC_DISPLAY_DESCRIPTION="Sign in through the configured UAR authentication service."
# Retained for compatibility and failure classification. It no longer enables
# a sign-in method during an outage.
AUTH_OIDC_OUTAGE_FALLBACK=off
# Legacy alternatives, read only while no auth.signInPolicy row exists.
# Allowed compatibility values: off, native, local, native_and_local. Configure
# all current methods in Admin -> System Configuration -> Sign-in instead.
AUTH_OIDC_ALTERNATE_SIGNIN=off
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=20
AUTH_ACCOUNT_LOCK_WINDOW_MS=900000
AUTH_ACCOUNT_LOCK_MAX_ATTEMPTS=5

# Set to true only when intentionally serving the production app over plain HTTP.
# Keep false when the app is available over HTTPS.
SESSION_COOKIE_ALLOW_INSECURE=false

# Bearer token used by /api/cron/process-lifecycle-queue (32+ characters).
CRON_SECRET=your_random_cron_secret_at_least_32_characters
PASSWORD_CLEANUP_SCHEDULER_ENABLED=false
PASSWORD_CREDENTIAL_RETENTION_DAYS=7
PASSWORD_CLEANUP_INTERVAL_SECONDS=21600
PASSWORD_CLEANUP_INITIAL_DELAY_SECONDS=60
PASSWORD_CLEANUP_HEALTH_MAX_AGE_SECONDS=86400
# Guarded automatic offboarding. First enabled run records a baseline only.
OFFBOARD_SCHEDULER_ENABLED=false
# Older missed work is never replayed beyond this many seconds.
OFFBOARD_SCHEDULER_GRACE_SECONDS=900

# Password expiration monitoring and notification scheduler.
PASSWORD_EXPIRATION_WARNING_DAYS=14
PASSWORD_EXPIRATION_SCHEDULER_ENABLED=false
PASSWORD_EXPIRATION_SCHEDULER_INTERVAL_SECONDS=21600
PASSWORD_EXPIRATION_SCHEDULER_INITIAL_DELAY_SECONDS=45
PASSWORD_EXPIRATION_SCHEDULER_HEALTH_MAX_AGE_SECONDS=86400

# Curated operational issue detector worker. Keep these integer values aligned
# with the Docker sidecar; invalid values fail application startup.
OPERATIONAL_DETECTOR_SCHEDULER_ENABLED=false
OPERATIONAL_DETECTOR_INTERVAL_SECONDS=60
OPERATIONAL_DETECTOR_HEALTH_MAX_AGE_SECONDS=300

# Durable workflow delivery, managed-endpoint probing, attachment quarantine,
# and the isolated probe helper. Keep schedulers false for their first deploy;
# enable individually only after migrations and persisted CronRun evidence.
FLOW_OUTBOX_SCHEDULER_ENABLED=false
FLOW_OUTBOX_INTERVAL_SECONDS=60
FLOW_OUTBOX_HEALTH_MAX_AGE_SECONDS=300
MONITORED_ENDPOINTS_SCHEDULER_ENABLED=false
MONITORED_ENDPOINTS_INTERVAL_SECONDS=60
MONITORED_ENDPOINTS_HEALTH_MAX_AGE_SECONDS=300
ATTACHMENT_QUARANTINE_PURGE_ENABLED=false
ATTACHMENT_QUARANTINE_PURGE_INTERVAL_SECONDS=86400
ATTACHMENT_QUARANTINE_PURGE_HEALTH_MAX_AGE_SECONDS=172800
MONITOR_PROBE_SHARED_SECRET=replace_with_a_random_secret_at_least_32_characters
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# Optional domain policy base DN if rootDSE cannot expose defaultNamingContext.
# LDAP_DOMAIN_SEARCH_BASE="dc=cpp,dc=edu"

# Trust X-Forwarded-For/X-Real-IP only when deployed behind a trusted reverse proxy
# that strips inbound client IP headers and sets canonical forwarding headers.
TRUST_PROXY_HEADERS=false
