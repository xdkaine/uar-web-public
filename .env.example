# Docker Compose production environment

# Database
DB_PASSWORD=replace_with_a_strong_database_password
# Privileged schema-migration target. This bootstrap example uses the existing
# database owner so a fresh stack can be initialized. After following
# docs/runbooks/database-role-separation.md, replace its user with
# uar_migration and an independent secret. Runtime services may temporarily
# fall back to this URL only during that staged rollout.
MIGRATION_DATABASE_URL=postgresql://uar_user:replace_with_a_url_encoded_database_password@postgres:5432/uar_database?sslmode=disable
# Least-privilege runtime targets. Leave empty only during the compatibility
# window; Compose then falls back to MIGRATION_DATABASE_URL. These roles must
# never be used to execute Prisma migrations.
PORTAL_DATABASE_URL=
AUTH_DATABASE_URL=
# Deployment-only, secret-free release evidence. The manifest format is shown
# in tools/migration-gate/backup-manifest.example.
MIGRATION_GATE_BACKUP_DECLARATION=/restricted/backups/uar-backup.manifest
MIGRATION_GATE_BACKUP_MAX_AGE_SECONDS=86400
MIGRATION_GATE_EXPECTED_OIDC_CLIENT_COUNT=0
MIGRATION_GATE_EXPECTED_OIDC_CLIENT_DIGEST=d41d8cd98f00b204e9800998ecf8427e
# md5 of the operator-approved source stack identifier; must match the backup manifest.
MIGRATION_GATE_EXPECTED_SOURCE_STACK_DIGEST=replace_with_32_lowercase_hex_characters
# Host maintenance access is loopback-only by default.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Application URLs
NEXT_PUBLIC_APP_URL=https://portal.example.org
NEXTAUTH_URL=https://portal.example.org

# Authentication and encryption (32+ random characters each)
NEXTAUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
ENCRYPTION_SECRET=replace_with_a_random_secret_at_least_32_characters
ENCRYPTION_SALT=replace_with_a_random_salt_at_least_32_characters
SESSION_COOKIE_ALLOW_INSECURE=false
AUTH_SESSION_MAX_AGE=
# Portal cap only; the signed upstream provider-session expiry may be earlier.
AUTH_OIDC_SESSION_MAX_AGE=28800

# Reverse proxy
# Enable only when the app port is not publicly reachable and the proxy replaces
# incoming forwarding headers with trusted values.
TRUST_PROXY_HEADERS=false

# Redis
REDIS_TOKEN=
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

# SMTP
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=portal@example.org
SMTP_PASSWORD=replace_with_smtp_password
EMAIL_FROM=portal@example.org
ADMIN_EMAIL=admins@example.org
FACULTY_EMAIL=
STUDENT_DIRECTOR_EMAILS=

# LDAP / Active Directory
LDAP_URL=ldaps://directory.example.org:636
LDAP_BIND_DN=CN=service-account,OU=Service Accounts,DC=example,DC=org
LDAP_BIND_PASSWORD=replace_with_ldap_password
LDAP_BASE=DC=example,DC=org
LDAP_SEARCH_BASE=OU=Users,DC=example,DC=org
LDAP_DOMAIN=example.org
# JSON array of complete LDAP group DNs; migrate legacy comma-separated CN lists.
LDAP_ADMIN_GROUPS='["CN=Domain Admins,CN=Users,DC=example,DC=org"]'
LDAP_GROUP2ADD=CN=Portal Users,OU=Groups,DC=example,DC=org
LDAP_KAMINO_INTERNAL_GROUP=CN=Internal Users,OU=Groups,DC=example,DC=org
LDAP_KAMINO_EXTERNAL_GROUP=CN=External Users,OU=Groups,DC=example,DC=org
LDAP_GROUPSEARCH=OU=Groups,DC=example,DC=org
# Set true ONLY for isolated lab environments whose directory certificates are expired or untrusted; traffic stays LDAPS-encrypted but is not verified.
# Posture for closed-network deployments is recorded in docs/adr/0016-ldap-certificate-verification-posture.md.
LDAP_ALLOW_INVALID_CERTS=false
# Optional: base64-encoded PEM CA certificate for a private LDAP certificate authority.
# Leave empty to use the operating system trust store.
LDAP_CA_CERT_BASE64=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_site_key
TURNSTILE_SECRET_KEY=replace_with_secret_key

# Guarded offboard scheduler
# Keep disabled during the first deployment. The first enabled run records a
# Redis baseline and intentionally does not process existing overdue work.
CRON_SECRET=replace_with_a_random_cron_secret_at_least_32_characters
OFFBOARD_SCHEDULER_ENABLED=false
OFFBOARD_SCHEDULER_INTERVAL_SECONDS=300
OFFBOARD_SCHEDULER_INITIAL_DELAY_SECONDS=30
OFFBOARD_SCHEDULER_HEALTH_MAX_AGE_SECONDS=1200
OFFBOARD_SCHEDULER_GRACE_SECONDS=900

# Account lifecycle queue drain scheduler
# POSTs /api/cron/process-lifecycle-queue, which drains queued lifecycle
# actions AND mass-email delivery waves, then re-invokes the guarded offboard
# logic. Alternative to the compose sidecar: leave it disabled and schedule
# the same authenticated POST from a host crontab against the published
# portal port (bearer CRON_SECRET).
LIFECYCLE_QUEUE_SCHEDULER_ENABLED=false
LIFECYCLE_QUEUE_SCHEDULER_INTERVAL_SECONDS=300
LIFECYCLE_QUEUE_SCHEDULER_INITIAL_DELAY_SECONDS=30
LIFECYCLE_QUEUE_SCHEDULER_HEALTH_MAX_AGE_SECONDS=1200

# Password expiration reminder scheduler
# The first enabled run immediately sends currently due 14/7/3/1-day or expired reminders.
PASSWORD_EXPIRATION_WARNING_DAYS=14
PASSWORD_EXPIRATION_SCHEDULER_ENABLED=false
PASSWORD_CLEANUP_SCHEDULER_ENABLED=false
# Encrypted generated credentials are retained for at most this many days after a terminal state.
PASSWORD_CREDENTIAL_RETENTION_DAYS=7
PASSWORD_CLEANUP_INTERVAL_SECONDS=21600
PASSWORD_CLEANUP_INITIAL_DELAY_SECONDS=60
PASSWORD_CLEANUP_HEALTH_MAX_AGE_SECONDS=86400
PASSWORD_EXPIRATION_SCHEDULER_INTERVAL_SECONDS=21600
PASSWORD_EXPIRATION_SCHEDULER_INITIAL_DELAY_SECONDS=45
PASSWORD_EXPIRATION_SCHEDULER_HEALTH_MAX_AGE_SECONDS=86400
LDAP_DOMAIN_SEARCH_BASE=DC=example,DC=org

# Ticket group directory snapshot scheduler (ADR-0007)
# Refreshes AD membership/mail snapshots for allowed ticket groups. Keep
# disabled until groups are configured in System Configuration.
TICKET_GROUP_SYNC_ENABLED=false
TICKET_GROUP_SYNC_INTERVAL_SECONDS=3600
TICKET_GROUP_SYNC_INITIAL_DELAY_SECONDS=45
TICKET_GROUP_SYNC_HEALTH_MAX_AGE_SECONDS=14400

# Directory health probe scheduler (ADR-0008)
# Periodically binds and reads the rootDSE over LDAPS; failures raise
# categorized service alerts through configured automation rules.
DIRECTORY_PROBE_ENABLED=false
DIRECTORY_PROBE_INTERVAL_SECONDS=300
DIRECTORY_PROBE_INITIAL_DELAY_SECONDS=60
DIRECTORY_PROBE_HEALTH_MAX_AGE_SECONDS=1800

# Internal asset store (ADR-0010)
# Dedicated container holding ticket evidence. It publishes no host ports;
# the app is the only ingress and authenticates with this shared secret.
# Must be exactly 64 lowercase hex characters (generate: openssl rand -hex 32);
# hex keeps it safe to interpolate into the asset nginx template.
ASSET_SERVICE_URL=http://asset-store:8090
ASSET_SHARED_SECRET=replace_with_64_lowercase_hex_characters_openssl_rand_hex_32
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# ===== OIDC authentication service (ADR-0012) =====
# AUTH_MODE is a legacy bootstrap input used only until the portal saves
# auth.signInPolicy. The saved portal policy then independently controls OIDC,
# direct AD, and portal local sign-in. Public auth-service URL: AUTH_ISSUER.
#
# HOST PORTS (shared-VM deployments): APP_PORT/AUTH_PORT are the published
# ports on the VM; container-internal ports stay 3002/3003 always. Defaults
# target a dev instance beside prod (portal 4002, auth 4003, loopback-only
# because nginx terminates TLS on the same host).
#
# INSTANCE namespaces container and image names (uar-{INSTANCE}-*) so dev can
# coexist with a prod checkout on the same VM. Never run two instances with
# the same INSTANCE value on one host.
INSTANCE=dev
APP_PORT=4002
APP_BIND_ADDRESS=127.0.0.1
AUTH_MODE=native
AUTH_ISSUER=http://localhost:4003
# Portal chooser copy used as the initial/default OIDC policy value. Once
# auth.signInPolicy is saved, its plain-text copy is authoritative. When these
# are empty the portal derives neutral copy from the configured issuer host.
AUTH_OIDC_DISPLAY_NAME=
AUTH_OIDC_DISPLAY_DESCRIPTION=
AUTH_PORT=4003
# Loopback bindings for the auth service. IPv6 is separate because Firefox
# resolves `localhost` to ::1 first; keep both unless you front the service
# with a proxy that owns the hostname.
AUTH_BIND_ADDRESS=127.0.0.1
AUTH_BIND6_ADDRESS=[::1]
AUTH_CLIENT_ID=uar-portal
AUTH_CLIENT_SECRET=replace_with_a_random_oidc_client_secret_at_least_32_characters
# Portal callback the auth service may redirect back to
AUTH_REDIRECT_URIS=http://localhost:4002/api/auth/oidc/callback
AUTH_POST_LOGOUT_URIS=http://localhost:4002
AUTH_REDIRECT_URI=http://localhost:4002/api/auth/oidc/callback
# Comma-separated random signing keys for provider session cookies
AUTH_COOKIE_KEYS=replace_with_random_key_1_min_32_chars,replace_with_random_key_2
# Fixed-window login rate limit per source IP enforced by the auth service
# (milliseconds per window, attempts per window). Defaults: 900000 / 20.
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=20
# Distributed account lock shared by the auth service and direct portal AD
# authentication.
AUTH_ACCOUNT_LOCK_WINDOW_MS=900000
AUTH_ACCOUNT_LOCK_MAX_ATTEMPTS=5
# Legacy input used only while no auth.signInPolicy is saved. Provider probes
# may classify an outage but no longer authorize a disabled portal method.
AUTH_OIDC_OUTAGE_FALLBACK=off
# Legacy alternate-method input used only while no auth.signInPolicy is saved.
# Allowed values remain off, native, local, native_and_local for compatibility.
AUTH_OIDC_ALTERNATE_SIGNIN=off
# DEV/TRUSTED-NETWORK ONLY: permits the plain-HTTP endpoints openid-client is
# asked to call. REQUIRED whenever OIDC_INTERNAL_ISSUER_URL mirrors the issuer
# onto the compose network (http://auth-service:3003), even when the
# browser-facing AUTH_ISSUER is HTTPS behind nginx. Set false only when every
# endpoint openid-client calls - external AND internal - is TLS.
AUTH_ALLOW_INSECURE_OIDC=false
# AUTH_INTERNAL_ISSUER_URL is the server-to-server issuer mirror interpolated
# into the portal container as OIDC_INTERNAL_ISSUER_URL (default
# http://auth-service:3003); authorization stays browser-facing via AUTH_ISSUER.
# AUTH_INTERNAL_ISSUER_URL=http://auth-service:3003
# Browser-facing base for auth redirects when NEXT_PUBLIC_APP_URL points at the
# production hostname but you sign in locally (leave empty in production).
# AUTH_BROWSER_BASE_URL=http://localhost:4002
# Shared secret for the auth service's internal branding API (sign-in page
# editor). Consumed ONLY by the auth-service container - the portal has no
# branding surfaces. Use at least 32 random characters.
AUTH_INTERNAL_BRANDING_TOKEN=
# Comma-separated AD usernames permitted to sign in to the auth service's own
# management console at {AUTH_ISSUER}/admin (branding + OIDC client manager).
# Leave empty to disable the console entirely.
AUTH_ADMIN_USERNAMES=
# Optional comma-separated AD group DNs or CNs whose members may use Auth
# Manager. Group membership is rechecked for AD-authenticated sessions.
AUTH_ADMIN_GROUPS=
# Enables auth-service-owned local recovery accounts for Auth Manager only.
# They cannot enter OIDC interactions or create portal sessions. Keep false
# until the recovery-account migration and an AD-managed roster are verified.
AUTH_ADMIN_LOCAL_RECOVERY_ENABLED=false
# AES-256-GCM key encrypting registry client secrets at rest in the auth
# service. Must be exactly 64 lowercase hex characters (generate: openssl
# rand -hex 32). Leave empty ONLY while no encrypted registry secrets exist:
# creating or rotating registry clients fails until it is set, and the auth
# service refuses to boot if encrypted secrets are present without the key.
AUTH_CLIENT_SECRET_ENC_KEY=
# Persistent RSA signing keys for issued ID/logout tokens (JWK Set JSON).
# Required in production; generate and rotate with
# docs/runbooks/auth-signing-keys.md. Non-production may use ephemeral keys.
AUTH_JWKS=
# The auth service consumes the same TRUST_PROXY_HEADERS setting declared
# above, keeping client-IP attribution identical across OIDC and fallback.
# Optional one-year, first-party device observations for security triage.
# "shadow" records scored evidence but never denies or steps up a sign-in.
# Generate a dedicated random value; do not reuse AUTH_COOKIE_KEYS.
AUTH_DEVICE_RISK_MODE=off
AUTH_DEVICE_EVIDENCE_KEY=
# During a controlled rotation, move the old key here (comma-separated for
# multiple transitions). New observations use the active key; old keys are
# matching-only. Keep them until the one-year observation window has elapsed.
AUTH_DEVICE_EVIDENCE_PREVIOUS_KEYS=
# Independent retention worker. Defaults delete at most 25,000 expired rows
# per daily pass and continue any backlog on the next pass.
AUTH_DEVICE_PURGE_INTERVAL_SECONDS=86400
AUTH_DEVICE_PURGE_RETRY_SECONDS=300
AUTH_DEVICE_PURGE_HEALTH_GRACE_SECONDS=900
AUTH_DEVICE_PURGE_BATCH_SIZE=1000
AUTH_DEVICE_PURGE_MAX_BATCHES=25

# Mass-email delivery worker. Keep disabled except during an approved canary;
# delivery_unknown recipients require evidence-based reconciliation, never an
# automatic retry.
MASS_EMAIL_SCHEDULER_ENABLED=false
MASS_EMAIL_SCHEDULER_INTERVAL_SECONDS=300
MASS_EMAIL_SCHEDULER_INITIAL_DELAY_SECONDS=30
MASS_EMAIL_SCHEDULER_HEALTH_MAX_AGE_SECONDS=1200
# LAB ONLY: permits plain ldap:// (cleartext bind passwords) when LDAP_URL
# does not start with ldaps://. Never enable where the network is untrusted.
LDAP_ALLOW_INSECURE_TRANSPORT=false
# Dev-only safety gate for databases restored from production clones. Allows
# directory reads/authentication but blocks SMTP and LDAP mutations.
PORTAL_CLONE_READ_ONLY=false

# Workflow tick worker (ADR-0013). Drains Wait-node timers and schedule
# triggers every minute. Disabled by default; enabling changes nothing until
# workflows are published in the admin Workflows tab.
WORKFLOW_TICK_ENABLED=false
WORKFLOW_TICK_INTERVAL_SECONDS=60
# Sidecar healthcheck tolerates this much silence since the last tick.
WORKFLOW_TICK_HEALTH_MAX_AGE_SECONDS=300

# Curated scheduler/access-request intervention detectors. Runs independently
# so slow detector work cannot delay workflow timers or outbox delivery.
OPERATIONAL_DETECTOR_SCHEDULER_ENABLED=false
OPERATIONAL_DETECTOR_INTERVAL_SECONDS=60
OPERATIONAL_DETECTOR_HEALTH_MAX_AGE_SECONDS=300

# Durable workflow-event retries run independently from workflow schedules.
FLOW_OUTBOX_SCHEDULER_ENABLED=false
FLOW_OUTBOX_INTERVAL_SECONDS=60
FLOW_OUTBOX_HEALTH_MAX_AGE_SECONDS=300

# Security retention worker. Enabled by default so quarantined malware does
# not persist indefinitely when visual workflows are disabled.
ATTACHMENT_QUARANTINE_PURGE_ENABLED=false
ATTACHMENT_QUARANTINE_PURGE_INTERVAL_SECONDS=86400
ATTACHMENT_QUARANTINE_PURGE_HEALTH_MAX_AGE_SECONDS=172800

# Approved HTTPS/TCP health checks. Targets must first be registered by an
# automation administrator; no arbitrary graph node can make network calls.
MONITORED_ENDPOINTS_SCHEDULER_ENABLED=false
MONITORED_ENDPOINTS_INTERVAL_SECONDS=60
MONITORED_ENDPOINTS_HEALTH_MAX_AGE_SECONDS=300
# Internal shared secret between the portal and the ICMP-only probe sidecar.
# Generate independently from CRON_SECRET; never expose or reuse it elsewhere.
MONITOR_PROBE_SHARED_SECRET=replace_with_a_random_secret_at_least_32_characters
