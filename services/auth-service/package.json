    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/sanitize-html": "^2.11.0",
    "eslint": "^9.17.0",
    "prisma": "^7.10.0",
    "typescript": "^5.7.2",
